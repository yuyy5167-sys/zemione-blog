---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function urlFor(post: (typeof posts)[number]) {
	const d = post.data.date;
	const year = String(d.getUTCFullYear());
	const month = String(d.getUTCMonth() + 1).padStart(2, '0');
	const day = String(d.getUTCDate()).padStart(2, '0');
	return `/${year}/${month}/${day}/${post.id}/`;
}
---

<Base title="ゼミワン｜「小・中」学生通信教材の研究家">
	<h1>ゼミワン｜「小・中」学生通信教材の研究家</h1>
	<ul style="list-style:none;padding:0">
		{
			posts.map((post) => (
				<li style="margin:14px 0;padding-bottom:14px;border-bottom:1px solid #eee">
					<a href={urlFor(post)} style="font-weight:bold;font-size:1.05em">
						{post.data.title}
					</a>
					<div style="color:#888;font-size:0.9em;margin-top:4px">
						<time>{post.data.date.toLocaleDateString('ja-JP')}</time>
					</div>
				</li>
			))
		}
	</ul>
</Base>
